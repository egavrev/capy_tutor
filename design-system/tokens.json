  "background": {
    "light": "image: bg_floral_stripes.jpg, scaled to screen height, centred, over color.background",
    "dark": "solid color.background, no image"
  },
  "typography": {
    "fontFamily": "Nunito",
    "styles": {
      "display": {
        "size_sp": 28,
        "lineHeight_sp": 36,
        "weight": 700
      },
      "title": {
        "size_sp": 22,
        "lineHeight_sp": 30,
        "weight": 600
      },
      "question": {
        "size_sp": 20,
        "lineHeight_sp": 28,
        "weight": 600
      },
      "body": {
        "size_sp": 17,
        "lineHeight_sp": 26,
        "weight": 400
      },
      "label": {
        "size_sp": 15,
        "lineHeight_sp": 20,
        "weight": 600
      },
      "caption": {
        "size_sp": 13,
        "lineHeight_sp": 18,
        "weight": 400
      }
    }
  },
  "dimension_dp": {
    "grid": 8,
    "screen_margin": 16,
    "block_gap": 24,
    "item_gap": 8,
    "radius_card": 16,
    "radius_button": 24,
    "radius_bubble": 24,
    "radius_small": 12,
    "button_height": 56,
    "button_height_small": 48,
    "touch_target": 48,
    "mic_button": 96,
    "mic_button_small": 48,
    "icon": 24,
    "icon_small": 18,
    "top_bar_height": 76,
    "bottom_nav_height": 72,
    "answer_card_min_height": 56,
    "chip_height": 40,
    "stroke_icon": 2,
    "capy_face": 48,
    "capy_hero": 160,
    "border": 1,
    "progress_bar": 6,
    "subject_dot": 10,
    "pin_dot": 16,
    "lesson_row_height": 60,
    "capy_bubble_avatar": 40
  },
  "motion": {
    "duration_ms": [
      200,
      300
    ],
    "easing": "ease-out (FastOutSlowIn)",
    "mic_pulse_ms": 2000
  },
  "icons": {
