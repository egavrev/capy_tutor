      "primary_pressed": "Primary, pressed",
      "secondary": "Secondary actions (Mauve)",
      "on_secondary": "Content on secondary",
      "secondary_pressed": "Secondary, pressed",
      "link": "Text buttons, links",
      "right": "Right answer (Blush pink)",
      "on_right": "Content on right (Raspberry)",
      "right_accent": "Bow fill on right",
      "wrong": "Wrong / not yet (Champagne)",
      "on_wrong": "Content on wrong (Toffee)",
