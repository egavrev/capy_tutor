{
  "name": "Capy Tutore",
  "version": "1.0.0",
  "platform": "Android (Material 3)",
  "principles": [
    "Pastel pink, warm and calm",
    "Right = pink, wrong = Champagne, inactive = Linen, never red",
    "Colour never carries meaning alone: every state also has an icon and words",
    "No shadows: separate surfaces by colour and 1 dp lines",
    "Touch targets ≥ 48 dp"
